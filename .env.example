# PAYMENT_MODE=demo: no real money is transferred (default)
# PAYMENT_MODE=live: payOS production API and real bank transfer
PAYMENT_MODE=demo

# DEMO: localhost is fine on the same PC. To scan the QR with another phone
# on the same WiFi, use http://YOUR_LOCAL_LAN_IP:8000 (and browse FitFlow via this IP).
# In Vercel, the deployment URL is used by default if PUBLIC_BASE_URL is unset.
# LIVE: MUST be a publicly reachable HTTPS URL; webhook URL is BASE_URL/api/webhooks/payos
PUBLIC_BASE_URL=http://localhost:8000

# Keep secrets server-side. Never put these in frontend or commit .env.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Gym demonstration's published sample membership prices (VND)
PRICE_MONTHLY_VND=600000
PRICE_3MONTH_VND=1650000
PRICE_6MONTH_VND=3000000

DATABASE_PATH=./data/payments.sqlite3

# LOCAL: leave DATABASE_URL blank to use SQLite.
# VERCEL: set DATABASE_URL to a PostgreSQL pooled connection string from Neon/Supabase.
# DO NOT commit real database credentials.
DATABASE_URL=
